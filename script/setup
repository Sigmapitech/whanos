#!/usr/bin/env python3
import getpass
import subprocess
import sys
import webbrowser

from pathlib import Path

script_dir = Path(__file__).parent.resolve()
base_dir = (script_dir / "../infra/jenkins").resolve()
env_file = base_dir / ".env"

if not base_dir.is_dir():
    print(f"Error: Jenkins directory not found at {base_dir}")
    sys.exit(1)

JENKINS_HOME = base_dir / "jenkins_home"
CONTAINER_NAME = "jenkins"

fresh_install = len(sys.argv) > 1 and sys.argv[1].lower() == "fresh"
result = subprocess.run(
    ["docker", "ps", "-q", "-f", f"name={CONTAINER_NAME}"],
    capture_output=True,
    text=True
)
container_running = bool(result.stdout.strip())

if container_running:
    if fresh_install:
        print(f"🛑 Stopping existing Jenkins container '{CONTAINER_NAME}'...")
        subprocess.run(["docker", "compose", "-f", str(base_dir / "docker-compose.yml"), "down"], check=True)
    else:
        print(f"⚡ Jenkins container '{CONTAINER_NAME}' is already running.")
        sys.exit(0)

if fresh_install:
    print("🧹 Performing fresh install")
    if JENKINS_HOME.exists():
        subprocess.run(["sudo", "rm", "-rf", str(JENKINS_HOME)], check=True)
    JENKINS_HOME.mkdir(parents=True, exist_ok=True)

    print("🚀 Building Jenkins image...")
    subprocess.run(
        ["docker", "compose", "-f", str(base_dir / "docker-compose.yml"), "build"],
        check=True
    )

    admin_password = getpass.getpass(prompt="Enter a password for the Jenkins admin user: ")
    with open(env_file, "w") as f:
        f.write(f"ADMIN_PASSWORD={admin_password}\n")

else:
    print("⚡ Skipping cleanup and build; starting existing Jenkins container...")

print("🧱 Starting Jenkins...")
subprocess.run(["docker", "compose", "-f", str(base_dir / "docker-compose.yml"), "up", "-d"], check=True)


print("\n📜 Streaming Jenkins logs (press Ctrl+C to exit)...\n")
process = subprocess.Popen(
    ["docker", "logs", "-f", CONTAINER_NAME],
    stdout=subprocess.PIPE,
    stderr=subprocess.STDOUT,
    text=True,
)

assert process.stdout is not None

jenkins_ready = False
jenkins_url = "http://localhost:8080"

try:
    for line in process.stdout:
        print(line, end="")
        if "Jenkins is fully up and running" in line:
            jenkins_ready = True
            print(f"🌐 Opening {jenkins_url}")
            webbrowser.open(jenkins_url)
            break
except KeyboardInterrupt:
    process.terminate()
