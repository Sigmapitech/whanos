#!/usr/bin/env python3
import sys
from pathlib import Path

repo_root = Path(".")
app_dir = repo_root / "app"

detection_files = {
    "C": repo_root / "Makefile",
    "Java": app_dir / "pom.xml",
    "Node.js": repo_root / "package.json",
    "Python": repo_root / "requirements.txt",
    "Befunge": app_dir / "main.bf",
}

if not app_dir.is_dir() and not any(f.is_file() for f in detection_files.values()):
    print("Error: repository not Whanos-compatible")
    sys.exit(1)

for lang, path in detection_files.items():
    if path.is_file():
        print(lang)
        sys.exit(0)

print("Unknown")
sys.exit(1)
