#!/usr/bin/env python3
"""
Render minimal Kubernetes manifests (Deployment + Service) from whanos.yml.

Usage:
  python script/kube_render.py \
    --image <registry/image:tag> \
    --name <app-name> \
    --namespace <k8s-namespace> \
    --input <path-to-whanos.yml> \
    --out out/

Notes:
- If PyYAML is not installed, the script will try to parse the file as JSON.
  You can either: pip install pyyaml, or provide whanos.yml in JSON format.
- Generates JSON manifests to avoid extra YAML dependencies.
"""
import argparse
import json
import os
import sys
from pathlib import Path
from typing import Any, Dict


def load_config(path: Path) -> dict:
    data = path.read_text()
    # Try YAML first if available, else fallback to JSON
    try:
        import yaml  # type: ignore
        return yaml.safe_load(data) or {}
    except Exception:
        try:
            return json.loads(data)
        except Exception as e:
            print(
                "Failed to parse whanos.yml. Install PyYAML (pip install pyyaml) or provide JSON.",
                file=sys.stderr,
            )
            raise e


def ensure_dir(p: Path):
    p.mkdir(parents=True, exist_ok=True)


def make_deployment(name: str, namespace: str, image: str, ports: list[int], resources: dict | None, replicas: int) -> dict:
    labels = {"app": name}
    container_ports = [{"containerPort": int(p)} for p in ports] if ports else []
    container: Dict[str, Any] = {
        "name": name,
        "image": image,
        "imagePullPolicy": "IfNotPresent",
    }
    if container_ports:
        container["ports"] = container_ports
    if resources:
        # Expecting Kubernetes-style resources dict
        container["resources"] = resources

    return {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": {"name": name, "namespace": namespace, "labels": labels},
        "spec": {
            "replicas": int(replicas),
            "selector": {"matchLabels": labels},
            "template": {
                "metadata": {"labels": labels},
                "spec": {
                    "containers": [container],
                    # Allow graceful shutdowns
                    "terminationGracePeriodSeconds": 30,
                },
            },
        },
    }


def make_service(name: str, namespace: str, ports: list[int]) -> dict | None:
    if not ports:
        return None
    labels = {"app": name}
    svc_ports = [
        {
            "name": f"port-{int(p)}",
            "port": int(p),
            "targetPort": int(p),
            "protocol": "TCP",
        }
        for p in ports
    ]
    return {
        "apiVersion": "v1",
        "kind": "Service",
        "metadata": {"name": name, "namespace": namespace, "labels": labels},
        "spec": {
            "type": "LoadBalancer",
            "selector": labels,
            "ports": svc_ports,
        },
    }


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--image", required=True, help="Full image reference (e.g., acr.azurecr.io/app:sha)")
    ap.add_argument("--name", required=True, help="Kubernetes app/name")
    ap.add_argument("--namespace", default="default", help="Kubernetes namespace (default: default)")
    ap.add_argument("--input", default="whanos.yml", help="Path to whanos.yml (or JSON)")
    ap.add_argument("--out", default=".kube-out", help="Output directory for rendered manifests")
    args = ap.parse_args()

    cfg = load_config(Path(args.input)) if args.input else {}
    deployment_cfg = (cfg or {}).get("deployment", {}) or {}

    replicas = int(deployment_cfg.get("replicas", 1))
    resources = deployment_cfg.get("resources")
    ports = deployment_cfg.get("ports", []) or []
    ports = [int(p) for p in ports]

    out_dir = Path(args.out)
    ensure_dir(out_dir)

    deployment = make_deployment(args.name, args.namespace, args.image, ports, resources, replicas)
    with (out_dir / "deployment.json").open("w") as f:
        json.dump(deployment, f, indent=2)

    service = make_service(args.name, args.namespace, ports)
    if service:
        with (out_dir / "service.json").open("w") as f:
            json.dump(service, f, indent=2)

    print(f"Rendered manifests to {out_dir}")


if __name__ == "__main__":
    main()
