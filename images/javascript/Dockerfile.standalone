FROM whanos-javascript AS builder

# Ensure we work in the app directory and fix permissions
WORKDIR /app
USER root

# Copy dependencies and install
COPY package.json package-lock.json* ./
RUN chown -R nixuser:nixuser /app
USER nixuser
RUN npm ci --omit=dev && npm cache clean --force

# Copy app source
COPY --chown=nixuser:nixuser app app

# Build artifacts (if any) - keep workspace tidy
USER root
RUN rm -rf /root/.npm /home/nixuser/.npm

FROM whanos-javascript
WORKDIR /app
COPY --from=builder /app /app

# Install tini as a minimal init to handle signals and reaping
RUN nix-env -iA nixpkgs.tini

# For discoverability and local runs
ENV PORT=3000 HOST=0.0.0.0
EXPOSE 3000

# Execution command
ENTRYPOINT ["tini", "-g", "--"]
CMD ["node", "."]
